# Copy to .env and fill in before running `docker compose up -d`.

# Generate with: php artisan key:generate --show
# (or, without PHP installed: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));")
APP_KEY=

APP_URL=http://localhost:8000
MINITOR_PORT=8000
DB_PASSWORD=minitor
